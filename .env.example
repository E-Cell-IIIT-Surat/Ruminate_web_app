# SMTP is used for newsletter delivery. These defaults are suitable when the
# IIIT Surat mailbox is hosted by Google Workspace.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
# Use a Google App Password, not the normal mailbox password.
SMTP_PASS=
SMTP_FROM=Ruminate E-Cell <ruminate.ecell@iiitsurat.ac.in>
NEWSLETTER_SUBMISSION_EMAIL=

# Public CDN origin for provider-independent media keys stored in JSON/data.
# Connect this custom domain to the production Cloudflare R2 public bucket.
NEXT_PUBLIC_MEDIA_BASE_URL=
